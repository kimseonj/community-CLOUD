logging {
  level = "info"
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

prometheus.scrape "spring_backend" {
  targets = [{
    "__address__" = sys.env("ALLOY_SPRING_TARGET")
    "job"         = "spring-backend"
    "instance"    = sys.env("ALLOY_INSTANCE")
  }]

  # prod profile uses server.servlet.context-path=/api
  metrics_path = "/api/actuator/prometheus"
  forward_to   = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  endpoint {
    url = sys.env("PROM_REMOTE_WRITE_URL")
  }
}

local.file_match "docker_logs" {
  path_targets = [{
    __path__  = sys.env("ALLOY_LOG_PATH_GLOB")
    job       = "spring-backend-logs"
    instance  = sys.env("ALLOY_INSTANCE")
    container = "community-backend"
  }]
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_json.receiver]
}

loki.process "docker_json" {
  stage.json {
    expressions = {
      log    = "log"
      stream = "stream"
      time   = "time"
    }
  }

  stage.labels {
    values = {
      stream = ""
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  stage.output {
    source = "log"
  }

  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
  }
}
