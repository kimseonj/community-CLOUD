# ECR 이미지 URI (deploy.sh 사용 시 자동 설정됨)
BACKEND_IMAGE=<AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com/community-back:latest
FRONTEND_IMAGE=<AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com/community-front:latest

# HTTPS + certbot
CERTBOT_PRIMARY_DOMAIN=jongju.duckdns.org
CERTBOT_EMAIL=you@example.com
CERTBOT_DOMAINS=jongju.duckdns.org
CERTBOT_STAGING=false

# 기본값은 컨테이너 내부 self-signed.
# certbot 발급 후 실제 경로로 교체:
# TLS_CERT_PATH=/etc/letsencrypt/live/jongju.duckdns.org/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/jongju.duckdns.org/privkey.pem
TLS_SERVER_NAME=jongju.duckdns.org
TLS_CERT_PATH=/etc/nginx/selfsigned/fullchain.pem
TLS_KEY_PATH=/etc/nginx/selfsigned/privkey.pem
