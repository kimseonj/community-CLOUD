# If backend runs in docker compose: backend:8080
# If backend runs directly on host EC2: host.docker.internal:8080
ALLOY_SPRING_TARGET=backend:8080
ALLOY_INSTANCE=app-ec2

# Example: http://10.0.1.20:9090/api/v1/write
PROM_REMOTE_WRITE_URL=http://<MONITORING_PRIVATE_IP>:9090/api/v1/write
# Example: http://10.0.1.20:3100/loki/api/v1/push
LOKI_WRITE_URL=http://<MONITORING_PRIVATE_IP>:3100/loki/api/v1/push

# Docker json logs path on host (default captures all container logs)
ALLOY_LOG_PATH_GLOB=/var/lib/docker/containers/*/*-json.log
