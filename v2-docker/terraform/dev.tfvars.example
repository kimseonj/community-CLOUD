aws_region   = "ap-northeast-2"
aws_profile  = "your-aws-profile"
environment  = "dev"

# If the generated name collides globally, uncomment and set a unique value.
# s3_bucket_name_override = "community-v2-docker-assets-dev-<unique-suffix>"

s3_bucket_base_name = "community-v2-docker-assets"
enable_versioning   = true
bucket_force_destroy = true

common_tags = {
  Owner = "your-name-or-team"
}
