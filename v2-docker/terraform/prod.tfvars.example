aws_region   = "ap-northeast-2"
aws_profile  = "your-aws-profile"
environment  = "prod"

# Keep prod bucket stable and globally unique.
# s3_bucket_name_override = "community-v2-docker-assets-prod-<unique-suffix>"

s3_bucket_base_name = "community-v2-docker-assets"
enable_versioning   = true
bucket_force_destroy = false

common_tags = {
  Owner = "your-name-or-team"
}
