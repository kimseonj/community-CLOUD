aws_region   = "ap-northeast-2"
aws_profile  = "your-aws-profile"
project_name = "community-v2-docker"
project_tag  = "community"
environment  = "dev"

# Final bucket name defaults to: <s3_bucket_base_name>-<environment>
s3_bucket_base_name = "community-v2-docker-assets"

enable_versioning   = true
bucket_force_destroy = false

common_tags = {
  Owner = "your-name-or-team"
}
